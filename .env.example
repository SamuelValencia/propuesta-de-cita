# Copia este archivo como ".env" y completa tus propios valores.
# Nunca subas el archivo ".env" real a un repositorio público.

SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,tu-app.onrender.com
CSRF_TRUSTED_ORIGINS=https://tu-app.onrender.com

# --- Base de datos ---
# Déjala vacía para usar SQLite en local.
# En producción (Render), pega aquí la "Connection string" de Supabase,
# ej: postgresql://usuario:password@host:5432/nombre_bd
DATABASE_URL=

# --- Correo (Resend vía SMTP) ---
# 1. Crea una cuenta en https://resend.com
# 2. Verifica tu dominio (o usa el remitente de pruebas onboarding@resend.dev)
# 3. Genera una API Key en el panel de Resend
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=re_tu_api_key_aqui
DEFAULT_FROM_EMAIL=Propuesta de Cita <onboarding@resend.dev>
# Opcional: te llega una copia oculta de cada confirmación
ADMIN_NOTIFICATION_EMAIL=

# --- Reglas de fecha/hora (opcional, tienen valores por defecto) ---
# Última fecha que se puede elegir (formato AAAA-MM-DD)
FECHA_LIMITE=2026-09-06
HORA_MINIMA_ENTRE_SEMANA=19:00
ZONA_HORARIA=America/Guayaquil

# --- WhatsApp (botón "Escríbeme" en la pantalla final y el correo) ---
# Formato wa.me: código de país + número, sin "+", espacios ni guiones.
# Ej. Ecuador +593 99 123 4567 -> 593991234567
WHATSAPP_NUMERO=
